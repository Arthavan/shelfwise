{
  "$comment": "Model and effort per role. Strong models where mistakes compound (spec, architecture, design, review); fast models for volume work. Edit freely.",
  "claudeBin": "claude",
  "roles": {
    "product-analyst": { "model": "claude-opus-5-5", "effort": "high", "budgetUsd": 5, "timeoutMin": 20 },
    "spec-critic":     { "model": "claude-opus-5-5", "effort": "medium", "budgetUsd": 2, "timeoutMin": 10 },
    "architect":       { "model": "claude-opus-5-5", "effort": "xhigh", "budgetUsd": 6, "timeoutMin": 25 },
    "designer":        { "model": "claude-opus-5-5", "effort": "high", "budgetUsd": 5, "timeoutMin": 20 },
    "scaffolder":      { "model": "claude-sonnet-5-5", "effort": "medium", "budgetUsd": 8, "timeoutMin": 45 },
    "planner":         { "model": "claude-opus-5-5", "effort": "high", "budgetUsd": 4, "timeoutMin": 20 },
    "test-author":     { "model": "claude-sonnet-5-5", "effort": "high", "budgetUsd": 8, "timeoutMin": 40 },
    "builder":         { "model": "claude-sonnet-5-5", "effort": "high", "budgetUsd": 10, "timeoutMin": 60,
                         "escalate": { "model": "claude-opus-5-5", "effort": "xhigh" } },
    "fixer":           { "agent": "builder", "model": "claude-sonnet-5-5", "effort": "high", "budgetUsd": 10, "timeoutMin": 60,
                         "escalate": { "model": "claude-opus-5-5", "effort": "xhigh" } },
    "polisher":        { "agent": "builder", "model": "claude-opus-5-5", "effort": "high", "budgetUsd": 10, "timeoutMin": 60 },
    "visual-reviewer": { "model": "claude-opus-5-5", "effort": "high", "budgetUsd": 6, "timeoutMin": 30 },
    "code-reviewer":   { "model": "claude-opus-5-5", "effort": "xhigh", "budgetUsd": 8, "timeoutMin": 30 },
    "release-manager": { "model": "claude-sonnet-5-5", "effort": "medium", "budgetUsd": 4, "timeoutMin": 20 }
  },
  "fallbackModels": {
    "claude-opus-5-5": "claude-opus-5",
    "claude-sonnet-5-5": "claude-sonnet-5"
  },
  "limits": {
    "runBudgetUsd": 150,
    "specRounds": 2,
    "specPassScore": 8,
    "parallelBuilders": 4,
    "taskAttempts": 3,
    "fixRounds": 5,
    "visualRounds": 2,
    "visualPassScore": 8,
    "reviewRounds": 2,
    "commandTimeoutMin": 20
  },
  "deploy": {
    "vercel": "npx --yes vercel deploy --prod --yes --token \"$VERCEL_TOKEN\""
  }
}
