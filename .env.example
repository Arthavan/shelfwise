# SQLite database file (relative to the project root). Optional: defaults to file:./dev.db.
# For Postgres, see "Deploying" in README.md.
DATABASE_URL="file:./dev.db"

# Enables the POST /api/test/reset hook. Leave UNSET everywhere except automated e2e runs
# (the Playwright webServer sets it). Never set it on a real deployment.
# E2E_TEST_HOOKS=1
